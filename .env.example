# Browser key: Maps JavaScript API only. Restrict it to your domains
# (http://localhost:3000/*, https://guessgeo.margauxfaurie.com/*).
GOOGLE_MAPS_API_KEY=

# Server key: used only by `npm run locations` (Street View Static API, metadata is free).
# Restrict it to that API. Never expose it in the browser.
GOOGLE_METADATA_API_KEY=

PORT=3000
